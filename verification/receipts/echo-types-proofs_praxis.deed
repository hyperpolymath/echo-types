;;
;; Proof receipt of echo-types (PROOF-POLICY §8.5.1, profile proof-receipt).
;; It describes source commit 7a78f1a and Agda run 44171715308 on that
;; commit: the cold-check job (Agda 2.7.0.1, checksum-pinned in
;; scripts/setup-agda.sh), and the Rocq (Coq 8.18.0) and Lean (Lean 4.30.0)
;; recheck jobs. Every :pwg is the value the reader derives (standards
;; deed_lint.js --proof-receipt-json). Rows, statements and scope are in
;; PROOF-STATUS.adoc, "Ledger (PWG receipt rows)".
;;
;; ET-1..ET-20 are PWG-3: no Rocq or Lean leg. ET-21 is PWG-2ii: both legs are
;; re-proved and RECONCILED (proofs/RECHECK-EchoSearchExample.adoc). It is not
;; PWG-1, because no receipt carries a pinned checker image.
;;
;; Import cone: agda --dependency-graph over the five cold-check roots gives
;; 400 modules: 132 of this repository, 256 of agda-stdlib at 8326c74 (v2.3),
;; 1 of absolute-zero at 8a3162a (CNO.agda) and 11 supplied with Agda. The
;; home manifest also lists scripts/setup-agda.sh, which holds both pins. The
;; run uses --no-libraries, so no library file is read.
;;
;; A comment-aware postulate scan of the cone finds only the six
;; prover-supplied postulates in (trusted-base). --safe refuses any other.
;; The --cubical island (EchoImageFactorizationPropCubical) and the
;; quarantined postulate shadow are outside these roots and are not graded.
(praxis-deed
  :schema-version "1.0.0"
  :canonical-name "echo-types-proof-receipt"
  :beholding-chora #u8"chora:estate/github.com/hyperpolymath"
  :profile proof-receipt
  :repository "hyperpolymath/echo-types"
  :source-commit "7a78f1a73de4c3520a451fa12411f0334e3d4421"
  (trusted-base
    (primitive :prover agda :module "Agda.Primitive" :name "Level" :binding "BUILTIN LEVEL")
    (primitive :prover agda :module "Agda.Primitive" :name "lzero" :binding "BUILTIN LEVELZERO")
    (primitive :prover agda :module "Agda.Primitive" :name "lsuc" :binding "BUILTIN LEVELSUC")
    (primitive :prover agda :module "Agda.Primitive" :name "_⊔_" :binding "BUILTIN LEVELMAX")
    (primitive :prover agda :module "Agda.Builtin.Char" :name "Char" :binding "BUILTIN CHAR")
    (primitive :prover agda :module "Agda.Builtin.String" :name "String" :binding "BUILTIN STRING"))
  (claim :id "ET-1" :pwg PWG-3 :foundation-diverse #f
    (leg :prover agda :route source :token proven :state AGDA-VERIFIED
